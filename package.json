{
  "name": "sports-broadcast-control",
  "version": "1.0.0",
  "description": "Control surface for live sports broadcasts. Orchestrates OBS Studio and CasparCG; it does not replace them.",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node scripts/test.mjs",
    "dist": "npm run build && electron-builder",
    "test:watch": "node scripts/test.mjs --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "express": "^5.2.1",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "Sports Broadcast Control contributors"
  }
}
